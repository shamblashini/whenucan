{
  "name": "whenucan",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply whenucan --local",
    "db:migrate:remote": "wrangler d1 migrations apply whenucan --remote",
    "setup:local": "node scripts/setup-local.mjs && pnpm db:migrate:local",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
